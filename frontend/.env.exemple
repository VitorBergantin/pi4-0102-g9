# Next.js: use os nomes NEXT_PUBLIC_ (VITE_ não é utilizado neste projeto).
# Copie para .env.local; não faça commit do .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demonstração local: Mosquitto no mesmo computador do navegador.
# Se o broker estiver em outro computador da mesma rede, troque localhost pelo IPv4 dele.
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001

# Não inclua credenciais administrativas em variáveis NEXT_PUBLIC_.
# Se houver autenticação, use somente uma conta MQTT restrita de leitura.
# NEXT_PUBLIC_MQTT_USER=
# NEXT_PUBLIC_MQTT_PASSWORD=
